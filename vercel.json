{
  "buildCommand": "cd client/zooner && npm install && npm run build",
  "outputDirectory": "client/zooner/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://zooner-app.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
